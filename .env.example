# ============================================================
# LUMINA AI - ÇEVRE DEĞİŞKENLERİ REHBERİ (.env.example)
# Bu dosyayı ".env" olarak kopyalayarak kendi anahtarlarınızı tanımlayabilirsiniz.
#
# Geliştirmede hiçbir sağlayıcı anahtarı zorunlu değildir; anahtar yoksa
# uygulama yerel/misafir modunda çalışır ve canlı sağlayıcı çağrısı yapmaz.
# ÜRETİMDE ise aşağıdaki zorunlu değerler eksikse sunucu BİLİNÇLİ OLARAK
# başlamaz (net hata verir): LUMINA_GUEST_SECRET, Firebase Admin servis
# hesabı, Firestore, güvenli auth/origin ayarları.
# ============================================================

# ------------------------------------------------------------
# 0. ÇALIŞMA ORTAMI (ÜRETİM İÇİN ZORUNLU)
# ------------------------------------------------------------
# development | production (prod eşdeğer). Üretimde "production" yapın.
# Açık değer verilmezse bilinen barındırma platformu işaretleri (RENDER,
# FLY_APP_NAME, K_SERVICE, DYNO vb.) üretim olarak algılanır.
LUMINA_ENV=development

# ------------------------------------------------------------
# ÜCRETLİ API POLİTİKASI
# ------------------------------------------------------------
# Lumina AI "önce ücretsiz katman" ilkesiyle çalışır. Ücretli sağlayıcılar
# varsayılan olarak KAPALIDIR ve açık kullanıcı onayı olmadan devreye girmez.
# Ücretli kullanımı bilinçli olarak açmak için aşağıdaki değişkeni "1" yapın.
# (Bu proje sürümünde ücretli sağlayıcı adaptörü varsayılan olarak yoktur;
#  değişken ileride eklenecek adaptörler için hazırlık amaçlıdır.)
LUMINA_ENABLE_PAID_PROVIDERS=0

# 1. Google Gemini API Anahtarı (Ücretsiz katman - https://aistudio.google.com/app/apikey)
# Lumina Pro, Pro+, Lüks ve Premium paketleri için amiral gemisi modellerini sağlar.
# Beklenen güncel modeller: gemini-4-argon, gemini-3.8-flash, gemini-3.6-flash,
# gemini-3.5-flash-lite, gemini-3.1-flash-lite; görsel için gemini-nano-banana-2.1
GEMINI_API_KEY=

# 2. Groq API Anahtarı (Ücretsiz katman - https://console.groq.com/keys)
# Ultra hızlı yanıtlar ve ücretsiz model kaskadı için kullanılır.
# Beklenen güncel modeller: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# NOT: mixtral-8x7b-32768, llama-3.3-70b-versatile ve llama-3.1-8b-instant KAPANMIŞTI
#      ("Groq 404" hatasının kök nedeni); katalog artık yalnızca güncel modelleri kullanır.
#
# ÖNEMLİ: Sohbette düz metin paylaşılan eski anahtarlar İFŞA OLDU kabul edilir.
# Bunları .env dosyasına, koda veya Git'e YAZMAYIN; Groq konsolundan iptal edip
# YENİ anahtarlar üretin. Yeni anahtarlar yalnızca sunucu ortam değişkenlerinde tutulur.
GROQ_API_KEY=

# ------------------------------------------------------------
# 2b. GROQ ANAHTAR HAVUZU (SUNUCU TARAFI, ÇOK KULLANICILI)
# ------------------------------------------------------------
# Havuz anahtarları SADECE sunucuda kalır; istemciye/loglara/Git'e asla
# yazılmaz. İstemciye yalnızca maskeli kimlik (key_id/masked_key) döner.
#
# - En fazla 20 anahtar tanımlanabilir (GROQ_KEY_01..GROQ_KEY_20).
# - Her anahtar en fazla 5 farklı kullanıcıya atanır.
# - Atama kriptografik olarak güvenli rastgele seçimle yapılır ve ilk girişte
#   otomatik gerçekleşir; sonraki oturumlarda aynı atama korunur.
# - Havuz dolarsa kullanıcıya Türkçe hata gösterilir ve yönetici kaydı oluşur.
#
# Kullanım: aşağıdaki satırları doldurun (yalnızca sunucu .env dosyasında).
GROQ_KEY_01=<your-groq-key-1-here>
GROQ_KEY_02=<your-groq-key-2-here>
GROQ_KEY_03=<your-groq-key-3-here>
GROQ_KEY_04=<your-groq-key-4-here>
GROQ_KEY_05=<your-groq-key-5-here>
GROQ_KEY_06=<your-groq-key-6-here>
GROQ_KEY_07=<your-groq-key-7-here>
# GROQ_KEY_08=
# GROQ_KEY_09=
# GROQ_KEY_10=
# ... GROQ_KEY_20'ye kadar genişletilebilir.
# Alternatif adlandırma: GROQ_API_KEY_1..GROQ_API_KEY_20 de desteklenir.
# Anahtar başına kullanıcı sınırı (varsayılan 5, en fazla 20'ye çıkarılabilir):
LUMINA_MAX_USERS_PER_KEY=5
# IP başına günlük azami yeni atama sayısı (kötüye kullanım koruması):
LUMINA_MAX_NEW_ASSIGNMENTS_PER_IP_PER_DAY=50

# 3. GitHub Personal Access Token (PAT) / GitHub Variable (Opsiyonel)
# GitHub Models üzerinden erişim sağlar.
# Uç nokta: https://models.github.ai/inference/chat/completions (kuruluş önekli model kimliği)
# Yedek uç: models.inference.ai.azure.com (eski Azure ucu — kaskadda ikincil)
GITHUB_TOKEN=

# 4. Firebase Proje ve Veritabanı Yapılandırması
# serviceAccountKey.json Firebase Console > Project Settings > Service Accounts
# bölümünden indirilir. Bu dosya yoksa uygulama yerel hafıza + misafir modunda çalışır.
FIREBASE_PROJECT_ID=lumina-ai-a42e0
FIREBASE_STORAGE_BUCKET=lumina-ai-a42e0.firebasestorage.app
FIREBASE_DATABASE_URL=https://lumina-ai-a42e0-default-rtdb.firebaseio.com
FIREBASE_KEY_PATH=serviceAccountKey.json

# 5. Canlı Web Araması (API tabanlı sağlayıcılar - en az biri gerekli)
# Sıra: Tavily -> Brave -> Serper. Hiçbiri yoksa canlı arama "geçici olarak
# kullanılamıyor" olarak raporlanır; DuckDuckGo anlık API'si artık kullanılmaz.
# Tavily: anahtar "Authorization: Bearer" başlığıyla gönderilir.
TAVILY_API_KEY=
# Brave Search API (https://brave.com/search/api/) - X-Subscription-Token
BRAVE_SEARCH_API_KEY=
# Serper (https://serper.dev) - X-API-KEY
SERPER_API_KEY=

# OpenStreetMap yedeği için tanımlayıcı User-Agent (Nominatim/Overpass ilkesi).
# Örn: "LuminaAI/3.2.4 (iletisim: destek@example.com)"
LUMINA_OSM_USER_AGENT=LuminaAI/3.2.4 (OSM fallback)

# 6. CORS İzinli Origin Adresleri (Virgülle ayrılmış)
# Sunucu yalnızca bu listedeki kaynakları kabul eder. Kimlikli isteklerde
# (Authorization/cookie) wildcard (*) ASLA kullanılmaz.
#
# Üretim origin'i tam olarak şudur: https://arelozcan3545-max.github.io
# Ek yerel geliştirme origin'leri varsayılan olarak açıktır. Üretimde yalnızca
# üretim origin'ini bırakmak için LUMINA_DISABLE_LOCAL_ORIGINS=1 yapın.
ALLOWED_ORIGINS=https://arelozcan3545-max.github.io,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8010,http://localhost:8010,http://127.0.0.1:5173,http://localhost:5173
# Üretimde ek yerel origin'leri (localhost/127.0.0.1) tamamen kapat:
# GÜVENLİ VARSAYILAN: 1. Yerel geliştirme için bilinçli olarak 0 yapın.
LUMINA_DISABLE_LOCAL_ORIGINS=1

# ------------------------------------------------------------
# 6b. GÜVENLİK JETONLARI (SUNUCU TARAFI)
# ------------------------------------------------------------
# Misafir kimliğini HMAC ile imzalamak için kullanılan gizli anahtar.
# En az 32 karakterlik rastgele bir değer üretin (örn. `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
# Boş bırakılırsa yalnızca geliştirme için geçici bir anahtar üretilir ve
# imzasız guest_* kimlikler reddedilir. Üretimde MUTLAKA tanımlayın.
LUMINA_GUEST_SECRET=
# /api/v1/keys/pool yönetici uç noktası için ayrı, uzun rastgele token.
LUMINA_ADMIN_TOKEN=
# İmzasız misafir kimliklerine (legacy) izin verilsin mi? Üretimde 0 bırakın.
LUMINA_ALLOW_UNSIGNED_GUEST=0

# ------------------------------------------------------------
# 6c. BULUT TTS (GERÇEK KONUŞMACI SESLERİ - OPSİYONEL)
# ------------------------------------------------------------# Yapılandırılmazsa uygulama yalnızca tarayıcıdaki gerçek/benzersiz sesleri
# kullanır; pitch ile sahte "farklı konuşmacı" üretilmez. Cihazda yeterli
# benzersiz ses yoksa ilgili profil "kullanılamıyor" olarak gösterilir.
#
# Google Cloud Text-to-Speech (https://console.cloud.google.com/apis/credentials)
GOOGLE_TTS_API_KEY=
# Azure Speech (https://portal.azure.com -> Speech Services -> Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Misafirlerin bulut TTS kullanmasına izin verilsin mi? (maliyet/kötüye kullanım)
LUMINA_ALLOW_GUEST_TTS=0

# ------------------------------------------------------------
# 6d. GÖRSEL ÜRETİM SAĞLAYICILARI (SIRA: Gemini -> Cloudflare)
# ------------------------------------------------------------
# Görsel üretimi YALNIZCA sunucu üzerinden yapılır; frontend'te client-side
# sağlayıcı yedeği yoktur. Kota üretimden ÖNCE atomik rezerve edilir, sağlayıcı
# başarısız olursa geri bırakılır.
#
# 1) Gemini Nano Banana (birincil): anahtar varsa ilk denenir.
# 2) Cloudflare Workers AI FLUX.1-schnell (ikincil): ücretsiz 10.000 neuron/gün.
#    Anahtar YOKSA bu sağlayıcı atlanır; kod çalışmaya devam eder.
#    Account ID + API token yalnızca sunucuda tutulur; repoya YAZILMAZ.
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id-here>
CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token-here>
# (Eski/kısa adlar da okunur: CF_ACCOUNT_ID, CF_API_TOKEN)
#
# BİRİNCİL/İKİNCİL SIRA (açıkça yapılandırılabilir):
# Varsayılan "gemini,cloudflare". Ücretsiz öncelikli çalışmak için
# "cloudflare,gemini" yapın. Pollinations bu değişkene YAZILAMAZ; yalnızca
# aşağıdaki LUMINA_ENABLE_POLLINATIONS ile ve her zaman son sırada açılır.
# NOT: Gemini görsel modellerinin API'de ÜCRETSİZ KATMANI YOKTUR; görsel
# başına ücretlendirilir (resmî fiyat sayfası). "Ücretsiz" olarak sunulmaz.
# Diğer sağlayıcılar için örnek sıra: gemini,cloudflare
#
# 3) Pollinations Classic — DENEYSEL ADAPTÖR, VARSAYILAN OLARAK KAPALIDIR.
#    ÜRETİMDE BİRİNCİL SAĞLAYICI OLARAK KULLANILAMAZ. Anahtarsız çalışır ama
#    tek model, en fazla 768x768, JPEG + logo ve IP başına 45 sn sınırı vardır.
#    Yalnızca ölçüm/deney için açmak isterseniz 1 yapın:
LUMINA_ENABLE_POLLINATIONS=0
# Acil kapatma anahtarı (1 = her koşulda kapatır, önceliklidir).
LUMINA_DISABLE_POLLINATIONS=0
#
# --- MEDYA GÜVENLİĞİ (imzalı, süreli görsel bağlantıları) ---
# /media klasörü herkese açık servis EDİLMEZ. Her görsel için kullanıcıya özel
# HMAC imzalı, süreli bağlantı üretilir. İmzalama anahtarı SUNUCUDA tutulur.
# Boş bırakılırsa yerel geliştirmede .lumina_media_key dosyası otomatik üretilir
# (repoya girmez). Üretimde en az 16 karakterlik güçlü bir değer tanımlayın.
LUMINA_MEDIA_SIGNING_KEY=
# Görsel bağlantısının geçerlilik süresi (saniye). Varsayılan: 7 gün.
LUMINA_MEDIA_URL_TTL_SECONDS=604800
# Bu süreden eski görseller diskten otomatik silinir. Varsayılan: 30 gün.
LUMINA_MEDIA_MAX_AGE_SECONDS=2592000
# Eski doğrulama anahtarı artık kullanılmıyor (geriye uyumluluk için okunur).
LUMINA_VERIFY_POLLINATIONS=0

# ------------------------------------------------------------
# 6e. KONUM / HARİTA / HAVA DURUMU (OPSİYONEL - GERÇEK API'LER)
# ------------------------------------------------------------
# Bu bölümdeki anahtarlar YALNIZCA sunucuda tutulur; tarayıcıya asla
# gönderilmez. Anahtar yoksa özellik "yapılandırılmadı" der ve SAHTE
# konum/işletme/hava verisi üretmez.
#
# Google Maps Platform (https://console.cloud.google.com/google/maps-apis)
# Aynı projede şu API'ler etkin olmalı:
#   - Geocoding API
#   - Places API (New)
#   - Routes API
#   - Maps JavaScript API (yalnızca tarayıcı haritası için)
# Sunucu anahtarı. IP kısıtlaması önerilir; istemciye GÖNDERİLMEZ.
GOOGLE_MAPS_API_KEY=
# (Eski ad; yalnızca geriye dönük uyumluluk için okunur. Boş bırakın.)
GOOGLE_PLACES_API_KEY=
# Tarayıcı (Maps JavaScript API) anahtarı. HTTP referrer + Maps JavaScript
# API ile kısıtlanmalıdır. Yalnızca oturum açmış istemciye verilir.
GOOGLE_MAPS_JS_API_KEY=
# İsteğe bağlı Map ID (cloud-based styling). Boşsa varsayılan stil kullanılır.
GOOGLE_MAPS_MAP_ID=

# Konum özelliği (0 yaparsanız canlı konum/hava/rota tamamen kapanır)
LUMINA_ENABLE_LOCATION=1
# Google API istek zaman aşımı (saniye). 2-20 arası. Varsayılan: 7
LUMINA_LOCATION_HTTP_TIMEOUT=7

# Open-Meteo (https://open-meteo.com). ÜCRETSİZ katman yalnızca TİCARİ
# OLMAYAN kullanım içindir (10.000/gün, 5.000/saat, 600/dakika) ve
# CC BY 4.0 atıf gerektirir. Ticari kullanım için müşteri API'si gerekir:
#   https://customer-api.open-meteo.com + OPEN_METEO_API_KEY
# Anahtar boşsa ücretsiz uç nokta kullanılır.
OPEN_METEO_API_KEY=

# OpenWeatherMap yedek sağlayıcı (https://openweathermap.org/api) - OPSİYONEL
OPENWEATHER_API_KEY=

# Konum kullanıcı kotaları (sağlayıcı kotasından AYRIDIR)
# Kullanıcı başına dakikalık / günlük istek ve misafir günlük isteği
LUMINA_LOCATION_RATE_LIMIT_PER_MIN=12
LUMINA_LOCATION_DAILY_PER_USER=60
LUMINA_LOCATION_DAILY_PER_GUEST=10
# Sağlayıcı tarafı günlük üst sınırlar (maliyet/kötüye kullanım koruması)
LUMINA_GOOGLE_PLACES_DAILY_MAX=2000
LUMINA_GOOGLE_GEOCODING_DAILY_MAX=2000
LUMINA_GOOGLE_ROUTES_DAILY_MAX=1000
LUMINA_OPEN_METEO_DAILY_MAX=8000
LUMINA_OPENWEATHER_DAILY_MAX=500
# Önbellek süreleri (saniye; en az 30)
LUMINA_GEOCODING_CACHE_TTL=86400
LUMINA_PLACES_CACHE_TTL=300
LUMINA_WEATHER_CACHE_TTL=600
LUMINA_ROUTES_CACHE_TTL=120
# Bayat önbellek penceresi (sağlayıcı hatasında gösterilir; "canlı" gibi sunulmaz)
LUMINA_WEATHER_STALE_CACHE_TTL=21600
# Open-Meteo geocoder fallback (Google Geocoding anahtarı yoksa)
LUMINA_ALLOW_OPEN_METEO_GEOCODING=1

# ------------------------------------------------------------
# 7. DOSYA İŞLEME SINIRLARI
# ------------------------------------------------------------
# Yüklenen dosya boyutu (MB). Varsayılan: 25 MB
LUMINA_MAX_UPLOAD_MB=25
# Tek bir dosyadan çıkarılacak azami metin karakteri. Varsayılan: 300000
LUMINA_MAX_TEXT_CHARS=300000
# Arşiv içindeki azami girdi sayısı. Varsayılan: 2000
LUMINA_MAX_ARCHIVE_ENTRIES=2000
# Arşiv açıldığında toplam azami boyut (MB). Varsayılan: 200 MB
LUMINA_MAX_ARCHIVE_MB=200
# Arşivdeki tek bir girdinin azami açılmış boyutu (MB). Varsayılan: 50 MB
LUMINA_MAX_ENTRY_MB=50
# Azami sıkıştırma oranı (zip bomb koruması). Varsayılan: 150
LUMINA_MAX_COMPRESSION_RATIO=150
# Ayrıştırma için azami süre (saniye). Varsayılan: 20
LUMINA_PARSE_TIMEOUT_SECS=20

# ------------------------------------------------------------
# 8. KİMLİK DOĞRULAMA (YEREL GELİŞTİRME)
# ------------------------------------------------------------
# Firebase kapalıyken yalnızca "local" token'ına izin verilir.
# GÜVENLİ VARSAYILAN: 0. Yerel geliştirme için bilinçli olarak 1 yapın.
# Üretimde 1 yapılırsa sunucu başlangıçta hata verir.
LUMINA_ALLOW_LOCAL_AUTH=0

OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

LUMINA_IMAGE_PROVIDER_ORDER=local
LUMINA_LIVE_NEWS=1

LUMINA_FOUNDER_EMAIL=
LUMINA_FOUNDER_CODE_SHA256=
